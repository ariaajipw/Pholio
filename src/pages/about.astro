---
/**
 * About page - photographer profile
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteConfig } from '../config/site';

const config = getSiteConfig();
const { photographer, contact } = config;

// Pre-compute URLs to avoid template literal issues in attributes
const email = contact.email || 'hello@example.com';
const whatsapp = contact.whatsapp || '6281234567890';
const whatsappDisplay = contact.whatsapp || '+62 812-3456-7890';
const instagram = contact.instagram || 'username';
const instagramClean = instagram.replace('@', '');

const pageTitle = `Tentang ${photographer}`;
const pageDescription = `Profil ${photographer} - ${config.tagline}`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="about-page" aria-labelledby="about-title">
    <div class="container">
      <header class="page-header">
        <h1 id="about-title" class="text-heading-page">Tentang {photographer}</h1>
      </header>

      <div class="about-content">
        <div class="about-image">
          <div class="about-image-placeholder" aria-hidden="true">
            <svg viewBox="0 0 400 500" fill="none" aria-hidden="true">
              <rect width="400" height="500" fill="var(--color-border)"/>
              <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="var(--color-muted)" font-size="16" font-family="system-ui">Foto Profil</text>
            </svg>
          </div>
        </div>

        <div class="about-text">
          <div class="text-body">
            <p>Fotografer dengan fokus pada lanskap, potret, dan dokumentasi. Setiap foto menceritakan kisah visual yang tulus dan otentik.</p>
            <p>Berbasis di {contact.location || 'Jakarta, Indonesia'}, melayani kebutuhan fotografi komersial, editorial, dan pribadi dengan pendekatan personal dan profesional.</p>
            <p>Filosofi kerja: foto terbaik bukan hanya soal teknis, tapi soal menangkap momen yang jujur dan bermakna.</p>
          </div>

          <div class="about-details">
            <h2 class="text-heading-section">Detail</h2>
            <dl>
              <div>
                <dt>Lokasi</dt>
                <dd>{contact.location || 'Jakarta, Indonesia'}</dd>
              </div>
              <div>
                <dt>Email</dt>
                <dd><a href={`mailto:${email}`}>{email}</a></dd>
              </div>
              <div>
                <dt>WhatsApp</dt>
                <dd>
                  <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer">
                    {whatsappDisplay}
                  </a>
                </dd>
              </div>
              <div>
                <dt>Instagram</dt>
                <dd>
                  <a href={`https://instagram.com/${instagramClean}`} target="_blank" rel="noopener noreferrer">
                    {contact.instagram || '@username'}
                  </a>
                </dd>
              </div>
            </dl>
          </div>

          <div class="about-cta">
            <a href="/contact" class="btn btn-primary">Hubungi Saya</a>
            <a href="/gallery" class="btn btn-secondary">Lihat Galeri</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    padding: 4rem 0 6rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .about-image {
    position: relative;
    max-width: 400px;
    margin: 0 auto;
  }

  .about-image-placeholder {
    width: 100%;
    aspect-ratio: 4/5;
  }

  .about-text {
    text-align: center;
  }

  .about-text .text-body {
    text-align: left;
    max-width: 600px;
    margin: 0 auto 2rem;
  }

  .about-text .text-body p {
    margin-bottom: 1.5rem;
  }

  .about-details {
    margin: 2rem 0;
    text-align: left;
    max-width: 400px;
    margin-left: auto;
    margin-right: auto;
  }

  .about-details dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1.5rem;
    margin-top: 1rem;
  }

  .about-details dt {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .about-details dd {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin: 0;
  }

  .about-details a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    transition: color 120ms;
  }

  .about-details a:hover {
    color: var(--color-brand);
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .about-content {
      grid-template-columns: 1fr 2fr;
      text-align: left;
    }

    .about-image {
      margin: 0;
    }

    .about-text {
      text-align: left;
    }

    .about-text .text-body {
      margin-left: 0;
      margin-right: 0;
    }

    .about-details {
      margin-left: 0;
      margin-right: 0;
    }
  }
</style>