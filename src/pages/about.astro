---
/**
 * About page - photographer profile
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteConfig } from '../config/site';

const config = getSiteConfig();
const { photographer, contact } = config;

// Pre-compute URLs to avoid template literal issues in attributes
const email = contact.email || 'hello@example.com';
const whatsapp = contact.whatsapp || '6281234567890';
const whatsappDisplay = contact.whatsapp || '+62 812-3456-7890';
const instagram = contact.instagram || 'username';
const instagramClean = instagram.replace('@', '');

const pageTitle = `Tentang ${photographer}`;
const pageDescription = `Profil ${photographer} - ${config.tagline}`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="py-[4rem] pb-[6rem]" aria-labelledby="about-title">
    <div class="container">
      <header class="text-center mb-[3rem]">
        <h1 id="about-title" class="text-heading-page">Tentang {photographer}</h1>
      </header>

      <div class="grid gap-[3rem] max-w-[1000px] mx-auto md:grid-cols-[1fr_2fr] md:text-left">
        <div class="about-image relative max-w-[400px] mx-auto md:mx-0">
          <div class="about-image-placeholder aspect-[4/5] w-full" aria-hidden="true">
            <svg viewBox="0 0 400 500" fill="none" aria-hidden="true" class="w-full h-full">
              <rect width="400" height="500" fill="var(--color-border)"/>
              <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="var(--color-muted)" font-size="16" font-family="system-ui">Foto Profil</text>
            </svg>
          </div>
        </div>

        <div class="about-text text-center md:text-left">
          <div class="text-body text-left md:text-left max-w-[600px] mx-auto mb-[2rem] md:mx-0">
            <p class="mb-[1.5rem]">Fotografer dengan fokus pada lanskap, potret, dan dokumentasi. Setiap foto menceritakan kisah visual yang tulus dan otentik.</p>
            <p class="mb-[1.5rem]">Berbasis di {contact.location || 'Jakarta, Indonesia'}, melayani kebutuhan fotografi komersial, editorial, dan pribadi dengan pendekatan personal dan profesional.</p>
            <p>Filosofi kerja: foto terbaik bukan hanya soal teknis, tapi soal menangkap momen yang jujur dan bermakna.</p>
          </div>

          <div class="about-details my-[2rem] mx-auto max-w-[400px] md:mx-0 text-left">
            <h2 class="text-heading-section">Detail</h2>
            <dl class="grid gap-y-[0.75rem] gap-x-[1.5rem] mt-[1rem] grid-cols-[auto_1fr]">
              <div>
                <dt class="font-semibold uppercase tracking-[0.06em] text-muted" style="font-size: 0.8125rem;">Lokasi</dt>
                <dd class="m-0 text-text" style="font-size: 0.9375rem;">{contact.location || 'Jakarta, Indonesia'}</dd>
              </div>
              <div>
                <dt class="font-semibold uppercase tracking-[0.06em] text-muted" style="font-size: 0.8125rem;">Email</dt>
                <dd class="m-0 text-text" style="font-size: 0.9375rem;"><a href={`mailto:${email}`} class="inline-flex items-center min-h-[44px] text-text no-underline transition-colors duration-120 hover:text-brand">{email}</a></dd>
              </div>
              <div>
                <dt class="font-semibold uppercase tracking-[0.06em] text-muted" style="font-size: 0.8125rem;">WhatsApp</dt>
                <dd class="m-0 text-text" style="font-size: 0.9375rem;"><a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-[44px] text-text no-underline transition-colors duration-120 hover:text-brand">{whatsappDisplay}</a></dd>
              </div>
              <div>
                <dt class="font-semibold uppercase tracking-[0.06em] text-muted" style="font-size: 0.8125rem;">Instagram</dt>
                <dd class="m-0 text-text" style="font-size: 0.9375rem;"><a href={`https://instagram.com/${instagramClean}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-[44px] text-text no-underline transition-colors duration-120 hover:text-brand">{contact.instagram || '@username'}</a></dd>
              </div>
            </dl>
          </div>

          <div class="about-cta flex flex-wrap justify-center gap-[1rem] mt-[2rem] md:justify-start">
            <a href="/contact" class="btn btn-primary">Hubungi Saya</a>
            <a href="/gallery" class="btn btn-secondary">Lihat Galeri</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>