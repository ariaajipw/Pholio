---
/**
 * 404 page - not found
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan" noIndex={true}>
  <section class="min-h-[60vh] flex items-center justify-center py-[4rem]" aria-labelledby="not-found-title">
    <div class="container">
      <div class="text-center max-w-[400px]">
        <p class="font-extrabold leading-none text-brand mb-[1rem] uppercase tracking-tighter" aria-hidden="true" style="font-size: clamp(6rem, 15vw, 12rem); letter-spacing: -0.02em;">404</p>
        <h1 id="not-found-title" class="font-extrabold tracking-tighter mb-[1rem]" style="font-size: clamp(1.75rem, 3.5vw, 2.75rem); line-height: 1.1; letter-spacing: -0.02em;">Halaman Tidak Ditemukan</h1>
        <p class="text-muted mb-[2rem] m-0">Maaf, halaman yang Anda cari tidak ada atau telah dipindahkan. Silakan periksa kembali URL atau gunakan navigasi di bawah untuk menemukan apa yang Anda butuhkan.</p>
        <div class="flex flex-wrap justify-center gap-[1rem]">
          <a href="/gallery" class="btn btn-primary">Buka Galeri</a>
          <a href="/" class="btn btn-secondary">Kembali ke Beranda</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>