---
/**
 * 404 page - not found
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman Tidak Ditemukan" description="Halaman yang Anda cari tidak ditemukan" noIndex={true}>
  <section class="not-found-page" aria-labelledby="not-found-title">
    <div class="container">
      <div class="not-found-content">
        <p class="not-found-code" aria-hidden="true">404</p>
        <h1 id="not-found-title" class="not-found-title">Halaman Tidak Ditemukan</h1>
        <p class="not-found-message text-body">
          Maaf, halaman yang Anda cari tidak ada atau telah dipindahkan.
          Silakan periksa kembali URL atau gunakan navigasi di bawah untuk menemukan apa yang Anda butuhkan.
        </p>
        <div class="not-found-links">
          <a href="/gallery" class="btn btn-primary">Buka Galeri</a>
          <a href="/" class="btn btn-secondary">Kembali ke Beranda</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 0;
  }

  .not-found-content {
    text-align: center;
    max-width: 400px;
  }

  .not-found-code {
    font-size: clamp(6rem, 15vw, 12rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-brand);
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .not-found-title {
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }

  .not-found-message {
    margin: 0 0 2rem;
    color: var(--color-muted);
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>