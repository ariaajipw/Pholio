---
/**
 * Gallery page — image-first mosaic grid.
 *
 * Click behavior (consistent in both lightbox states):
 *   - Photo → opens lightbox (only when `features.lightbox` is on)
 *   - "Lihat detail produk" link → product detail page (when productId set)
 *
 * Frames use designed crop ratios (mosaic). If a gallery item provides
 * `width`/`height` in gallery.json, its natural ratio is used instead
 * (see ARCHITECTURE.md §4 / DESIGN.md §15).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Lightbox from '../components/Lightbox.astro';
import { getSiteConfig } from '../config/site';
import { hasPublicAsset } from '../lib/has-public-asset';
import galleryData from '../content/gallery.json';

const config = getSiteConfig();
const { features, photographer } = config;
const showFilter = features.filter;
const showLightbox = features.lightbox;

const frameAspect = (item: any) =>
  item.width && item.height ? `${item.width} / ${item.height}` : undefined;
---

<BaseLayout title="Galeri" description={`Galeri foto ${photographer} - ${config.tagline}`}>
  <section class="gallery-page wa-safe-bottom" aria-labelledby="gallery-title">
    <div class="container">
      <header class="page-header">
        <h1 id="gallery-title" class="text-heading-page">Galeri</h1>
        <p class="text-caption">Koleksi karya fotografi</p>
      </header>

      {showFilter && (
        <div class="filter-bar" role="group" aria-label="Filter kategori">
          <button class="filter-btn filter-btn--active" data-filter="all" aria-pressed="true">
            Semua <span class="filter-count">({galleryData.length})</span>
          </button>
          {Array.from(new Set(galleryData.map((item: any) => item.category))).map((category) => {
            const count = galleryData.filter((item: any) => item.category === category).length;
            return (
              <button class="filter-btn" data-filter={category} aria-pressed="false">
                {category.charAt(0).toUpperCase() + category.slice(1)} <span class="filter-count">({count})</span>
              </button>
            );
          })}
        </div>
      )}

      <div class="gallery-grid" role="list">
        {galleryData.map((item: any, index: number) => (
          <article class={`gallery-item gallery-item--${index}`} role="listitem" data-category={item.category}>
            <div class="photo-frame gallery-frame" style={frameAspect(item) ? `aspect-ratio: ${frameAspect(item)}` : undefined}>
              <div class="frame-fallback" aria-hidden="true">
                <svg viewBox="0 0 400 300" fill="none" aria-hidden="true">
                  <rect width="400" height="300" fill="var(--color-border)"/>
                  <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="var(--color-muted)" font-size="14" font-family="system-ui">{item.title}</text>
                </svg>
              </div>

              {showLightbox ? (
                <button
                  type="button"
                  class="gallery-trigger"
                  data-lightbox-open
                  data-lightbox-src={item.src}
                  data-lightbox-alt={item.alt}
                  data-lightbox-title={item.title}
                  aria-label={`Perbesar foto: ${item.title}`}
                >
                  {hasPublicAsset(item.src) && (
                    <img
                      src={item.src}
                      alt={item.alt}
                      class="gallery-image"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </button>
              ) : (
                hasPublicAsset(item.src) && (
                  <img
                    src={item.src}
                    alt={item.alt}
                    class="gallery-image"
                    loading="lazy"
                    decoding="async"
                  />
                )
              )}

              <div class="gallery-caption">
                <h2 class="gallery-item-title">{item.title}</h2>
                <span class="gallery-item-category">{item.category}</span>
                {item.productId && (
                  <a class="gallery-product-link" href={`/products/${item.productId}`}>
                    Lihat detail produk &rarr;
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      {galleryData.length === 0 && (
        <p class="gallery-empty">Belum ada foto di galeri. Tambahkan data di <code>src/content/gallery.json</code>.</p>
      )}
    </div>
  </section>

  {showLightbox && <Lightbox />}
</BaseLayout>

<style>
  .gallery-page {
    padding: 4rem 0 6rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .page-header h1 {
    margin: 0 0 0.75rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    padding: 0 1rem;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0;
    cursor: pointer;
    transition: all 120ms;
  }

  .filter-btn:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .filter-btn--active {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-on-brand);
  }

  .filter-count {
    font-size: 0.75rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    opacity: 0.7;
  }

  .filter-btn--active .filter-count {
    color: var(--color-on-brand);
    opacity: 1;
  }

  /* ---------- Mosaic grid ---------- */
  .gallery-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(12px, 2vw, 24px);
  }

  .gallery-item {
    min-width: 0;
  }

  .gallery-frame {
    width: 100%;
    height: 100%;
    aspect-ratio: 4/3;
  }

  .gallery-image,
  .gallery-trigger {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .gallery-image {
    object-fit: cover;
  }

  .gallery-trigger {
    display: block;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
  }

  .gallery-trigger:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -3px;
  }

  .gallery-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem;
    background: linear-gradient(to top, var(--color-scrim), transparent);
    color: white;
    pointer-events: none;
  }

  .gallery-product-link {
    align-self: flex-start;
    margin-top: 0.25rem;
    padding: 0.5rem 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    pointer-events: auto;
  }

  .gallery-product-link:hover {
    opacity: 0.8;
  }

  .gallery-item-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin: 0;
  }

  .gallery-item-category {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.9;
  }

  .gallery-empty {
    text-align: center;
    color: var(--color-muted);
    padding: 4rem;
    font-size: 1rem;
  }

  .gallery-empty code {
    background: var(--color-border);
    padding: 0.125rem 0.375rem;
    font-family: monospace;
    font-size: 0.875rem;
  }

  /* Ritme mosaic: pasangan 7/5 di baris yang sama, satu foto lebar
     penuh setiap tiga item (DESIGN §5.1 — variasi ukuran terarah). */
  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr 1fr;
    }

    .gallery-item--2,
    .gallery-item--5 {
      grid-column: 1 / -1;
    }

    .gallery-item--2 .gallery-frame,
    .gallery-item--5 .gallery-frame {
      aspect-ratio: 21/9;
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(12, 1fr);
    }

    .gallery-item {
      grid-column: span 6;
    }

    .gallery-item--0,
    .gallery-item--3 {
      grid-column: span 7;
    }

    .gallery-item--1,
    .gallery-item--4 {
      grid-column: span 5;
    }

    .gallery-item--2,
    .gallery-item--5 {
      grid-column: 1 / -1;
    }

    .gallery-item--0 .gallery-frame,
    .gallery-item--1 .gallery-frame,
    .gallery-item--3 .gallery-frame,
    .gallery-item--4 .gallery-frame {
      aspect-ratio: 16/10;
    }

    .gallery-item--2 .gallery-frame,
    .gallery-item--5 .gallery-frame {
      aspect-ratio: 21/9;
    }
  }
</style>

<script>
  // Client-side filter functionality
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update button states
        filterButtons.forEach((b) => {
          b.classList.remove('filter-btn--active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('filter-btn--active');
        btn.setAttribute('aria-pressed', 'true');

        // Filter items
        galleryItems.forEach((item) => {
          const element = item as HTMLElement;
          const category = element.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            element.style.display = '';
          } else {
            element.style.display = 'none';
          }
        });
      });
    });
  });
</script>
