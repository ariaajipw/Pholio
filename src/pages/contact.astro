---
/**
 * Contact page - contact information and WhatsApp CTA
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteConfig } from '../config/site';
import { buildWhatsAppInquiryUrl } from '../lib/wa-formatter';

const config = getSiteConfig();
const { photographer, contact, social } = config;
const whatsappUrl = contact.whatsapp
  ? buildWhatsAppInquiryUrl(contact.whatsapp, 'Halo, saya ingin bertanya tentang portofolio dan layanan Anda.')
  : '#';
---

<BaseLayout title="Kontak" description={`Kontak ${photographer} - ${config.tagline}`}>
  <section class="py-[4rem] pb-[6rem]" aria-labelledby="contact-title">
    <div class="container">
      <header class="text-center mb-[3rem]">
        <h1 id="contact-title" class="text-heading-page">Kontak</h1>
        <p class="text-caption">Hubungi kami untuk pertanyaan, kolaborasi, atau pemesanan</p>
      </header>

      <div class="grid gap-[3rem] max-w-[1000px] mx-auto md:grid-cols-[2fr_1fr]">
        <div class="contact-main flex flex-col gap-[2.5rem] md:gap-[2rem]">
          <div class="contact-method p-[2rem] bg-surface border border-border">
            <h2 class="text-heading-section mb-[0.75rem]">WhatsApp</h2>
            <p class="text-body text-muted mb-[1.5rem] m-0">Cara tercepat untuk menghubungi kami. Klik tombol di bawah untuk memulai percakapan.</p>
            {contact.whatsapp && (
              <a
                href={whatsappUrl}
                class="btn btn-primary whatsapp-main-btn inline-flex items-center gap-[0.75rem] w-full justify-center"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
                Chat via WhatsApp
              </a>
            )}
          </div>

          <div class="contact-method p-[2rem] bg-surface border border-border">
            <h2 class="text-heading-section mb-[0.75rem]">Email</h2>
            <p class="text-body text-muted mb-[1.5rem] m-0">Untuk pertanyaan formal, proposal, atau dokumen yang memerlukan lampiran.</p>
            {contact.email && (
              <a href={`mailto:${contact.email}`} class="btn btn-secondary">Kirim Email</a>
            )}
          </div>

          <div class="contact-method p-[2rem] bg-surface border border-border">
            <h2 class="text-heading-section mb-[0.75rem]">Media Sosial</h2>
            <p class="text-body text-muted mb-[1.5rem] m-0">Ikuti dan hubungi kami melalui platform sosial.</p>
            <div class="social-links flex flex-wrap gap-[0.75rem]">
              {social.length > 0 ? (
                social.map((item) => (
                  <a href={item.url} target="_blank" rel="noopener noreferrer" class="social-link inline-flex items-center gap-[0.5rem] px-[1rem] py-[0.625rem] font-medium text-text bg-bg border border-border no-underline transition-all duration-120 hover:border-brand hover:text-brand" style="font-size: 0.875rem;">
                    {item.icon}
                    <span>{item.name}</span>
                  </a>
                ))
              ) : contact.instagram && (
                <a href={`https://instagram.com/${(contact.instagram || '').replace('@', '')}`} target="_blank" rel="noopener noreferrer" class="social-link inline-flex items-center gap-[0.5rem] px-[1rem] py-[0.625rem] font-medium text-text bg-bg border border-border no-underline transition-all duration-120 hover:border-brand hover:text-brand" style="font-size: 0.875rem;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                  </svg>
                  <span>Instagram</span>
                </a>
              )}
            </div>
          </div>
        </div>

        <div class="contact-info p-[2rem] bg-surface border border-border">
          <h2 class="text-heading-section mb-[1.5rem]">Informasi</h2>
          <dl class="contact-details grid gap-[1rem]">
            <div class="flex flex-col gap-[0.25rem]">
              <dt class="font-semibold uppercase tracking-[0.06em] text-muted" style="font-size: 0.8125rem;">Nama</dt>
              <dd class="m-0 text-text" style="font-size: 0.9375rem;">{photographer}</dd>
            </div>
            {contact.location && (
              <div class="flex flex-col gap-[0.25rem]">
                <dt class="font-semibold uppercase tracking-[0.06em] text-muted" style="font-size: 0.8125rem;">Lokasi</dt>
                <dd class="m-0 text-text" style="font-size: 0.9375rem;">{contact.location}</dd>
              </div>
            )}
            {contact.email && (
              <div class="flex flex-col gap-[0.25rem]">
                <dt class="font-semibold uppercase tracking-[0.06em] text-muted" style="font-size: 0.8125rem;">Email</dt>
                <dd class="m-0 text-text" style="font-size: 0.9375rem;"><a href={`mailto:${contact.email}`} class="inline-flex items-center min-h-[44px] text-inherit no-underline transition-colors duration-120 hover:text-brand">{contact.email}</a></dd>
              </div>
            )}
            {contact.whatsapp && (
              <div class="flex flex-col gap-[0.25rem]">
                <dt class="font-semibold uppercase tracking-[0.06em] text-muted" style="font-size: 0.8125rem;">WhatsApp</dt>
                <dd class="m-0 text-text" style="font-size: 0.9375rem;"><a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-[44px] text-inherit no-underline transition-colors duration-120 hover:text-brand">{contact.whatsapp}</a></dd>
              </div>
            )}
          </dl>

          <div class="contact-note mt-[2rem] pt-[1.5rem] border-t border-border">
            <h3 class="font-semibold mb-[0.75rem] m-0" style="font-size: 1rem;">Jam Operasional</h3>
            <p class="text-body m-0">Senin–Jumat: 09:00–18:00 WIB<br />Sabtu: 09:00–14:00 WIB<br />Minggu: Tutup</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>