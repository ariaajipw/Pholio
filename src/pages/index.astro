---
/**
 * Home page — image-first hero + featured work
 *
 * hero.variant = 'stagger' (default Bold): asymmetric composition with a
 * large featured photo beside a staggered display headline, photographer
 * identity, and clear CTAs. The headline is a single meaningful sentence
 * (screen-reader friendly — no aria-hidden on the page title).
 *
 * hero.variant = 'overlap' (Editorial alternative): keeps the original
 * editorial composition with a readable h1 caption.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import GridLines from '../components/GridLines.astro';
import { getSiteConfig } from '../config/site';
import { hasPublicAsset } from '../lib/has-public-asset';
import galleryData from '../content/gallery.json';

const config = getSiteConfig();
const { hero, photographer, tagline, name } = config;

const featured = galleryData
  .filter((item: any) => item.featured)
  .slice(0, 3);
const heroPhoto = featured[0] ?? galleryData[0];
const heroHasImage = hasPublicAsset(heroPhoto?.src);
---

<BaseLayout title={photographer} description={tagline}>
  {hero.variant === 'stagger' && (
    <section class="hero hero-stagger" aria-labelledby="hero-title">
      <GridLines />
      <div class="container hero-inner">
        <div class="hero-media">
          <a
            href="/gallery"
            class="photo-frame hero-photo"
            aria-label={`Foto unggulan: ${heroPhoto?.title ?? 'karya pilihan'} — buka galeri`}
          >
            <div class="frame-fallback" aria-hidden="true">
              <svg viewBox="0 0 400 500" fill="none" aria-hidden="true">
                <rect width="400" height="500" fill="var(--color-border)"/>
                <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="var(--color-muted)" font-size="16" font-family="system-ui">{heroPhoto?.title ?? 'Foto Unggulan'}</text>
              </svg>
            </div>
            {heroHasImage && (
              <img
                src={heroPhoto?.src}
                alt={heroPhoto?.alt ?? ''}
                fetchpriority="high"
                decoding="async"
              />
            )}
            <div class="hero-photo-caption scrim-gradient">
              <span class="hero-photo-title">{heroPhoto?.title}</span>
              <span class="hero-photo-category">{heroPhoto?.category}</span>
            </div>
          </a>
        </div>

        <div class="hero-body">
          <p class="hero-identity">{photographer} — {name}</p>
          <h1 id="hero-title" class="hero-title text-display-stagger">
            <span>Fotografi </span>
            <span>adalah </span>
            <span>cerita</span>
          </h1>
          <p class="hero-lede text-body">
            {tagline}. Koleksi lanskap, potret, dan momen yang dikurasi untuk diceritakan kembali.
          </p>
          <div class="hero-cta">
            <a href="/gallery" class="btn btn-primary">Lihat Galeri</a>
            <a href="/shop" class="btn btn-secondary">Buka Toko</a>
          </div>
        </div>
      </div>
    </section>
  )}

  {hero.variant === 'overlap' && (
    <section class="hero hero-overlap" aria-labelledby="hero-title">
      <div class="container hero-inner-overlap">
        <div class="hero-header-line">
          <span class="hero-nav-label">Arsip</span>
          <span class="hero-wordmark" aria-hidden="true">{photographer}</span>
          <span class="hero-nav-label">Kontak</span>
        </div>

        <div class="hero-content-overlap">
          <div class="hero-text-block">
            <h1 id="hero-title" class="hero-caption-title">
              {photographer} — {tagline}
            </h1>
            <p class="hero-caption">Karya pilihan dari portofolio</p>
          </div>

          <div class="hero-image-wrapper">
            <div class="photo-frame hero-image-placeholder">
              <div class="frame-fallback" aria-hidden="true">
                <svg viewBox="0 0 400 500" fill="none" aria-hidden="true">
                  <rect width="400" height="500" fill="var(--color-border)"/>
                  <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="var(--color-muted)" font-size="16" font-family="system-ui">{heroPhoto?.title ?? 'Foto Hero'}</text>
                </svg>
              </div>
              {heroHasImage && (
                <img
                  src={heroPhoto?.src}
                  alt={heroPhoto?.alt ?? ''}
                  fetchpriority="high"
                  decoding="async"
                />
              )}
            </div>
          </div>

          <p class="hero-display text-display-overlap" aria-hidden="true">Fotografi</p>

          <div class="hero-cta">
            <a href="/gallery" class="btn btn-primary">Lihat Semua Foto</a>
            <a href="/shop" class="btn btn-secondary">Buka Toko</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Featured Work -->
  <section class="featured-work" aria-labelledby="featured-title">
    <div class="container">
      <header class="section-head">
        <h2 id="featured-title" class="text-heading-section">Karya Pilihan</h2>
      </header>

      <div class="featured-grid" role="list">
        {featured.map((item: any, i: number) => (
          <article class={`featured-item featured-item--${i}`} role="listitem">
            <a
              href={item.productId ? `/products/${item.productId}` : '/gallery'}
              class="photo-frame featured-photo"
              aria-label={`${item.title} — ${item.productId ? 'lihat detail produk' : 'buka galeri'}`}
            >
              <div class="frame-fallback" aria-hidden="true">
                <svg viewBox="0 0 400 300" fill="none" aria-hidden="true">
                  <rect width="400" height="300" fill="var(--color-border)"/>
                  <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="var(--color-muted)" font-size="14" font-family="system-ui">{item.title}</text>
                </svg>
              </div>
              {hasPublicAsset(item.src) && (
                <img
                  src={item.src}
                  alt={item.alt}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="featured-caption scrim-gradient">
                <h3 class="featured-title">{item.title}</h3>
                <span class="featured-category">{item.category}</span>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="section-more">
        <a href="/gallery" class="btn btn-secondary">Lihat Semua Karya</a>
      </div>
    </div>
  </section>

  <!-- Intro / About Preview -->
  <section class="intro-section" aria-labelledby="intro-title">
    <div class="container intro-inner">
      <div class="intro-text">
        <h2 id="intro-title" class="text-heading-section">Tentang {photographer}</h2>
        <div class="text-body">
          <p>Fotografer dengan fokus pada lanskap, potret, dan dokumentasi. Setiap foto menceritakan kisah visual yang tulus.</p>
          <p>Berbasis di {config.contact.location || 'Jakarta, Indonesia'}, melayani kebutuhan fotografi komersial, editorial, dan pribadi.</p>
        </div>
        <div class="intro-cta">
          <a href="/about" class="btn btn-secondary">Baca Selengkapnya &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-content">
        <h2 id="cta-title" class="text-heading-section">Jelajahi Lebih Lanjut</h2>
        <div class="cta-buttons">
          <a href="/gallery" class="btn btn-primary">Buka Galeri</a>
          <a href="/shop" class="btn btn-secondary">Lihat Katalog</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero Stagger (Bold default) ---------- */
  .hero-stagger {
    position: relative;
    padding: 3rem 0 6rem;
    overflow: clip;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-media {
    min-width: 0;
  }

  .hero-photo {
    display: block;
    aspect-ratio: 4/3;
    text-decoration: none;
  }

  .hero-photo-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem;
    color: #ffffff;
  }

  .hero-photo-title {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .hero-photo-category {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.9;
  }

  .hero-body {
    min-width: 0;
  }

  .hero-identity {
    margin: 0 0 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-brand);
  }

  .hero-title {
    margin: 0 0 2rem;
  }

  .hero-title span {
    display: block;
  }

  .hero-lede {
    margin: 0 0 2.5rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* ---------- Hero Overlap (Editorial alternative) ---------- */
  .hero-overlap {
    position: relative;
    padding: 4rem 0 6rem;
  }

  .hero-header-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-nav-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .hero-wordmark {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text);
  }

  .hero-content-overlap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    position: relative;
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-caption-title {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: 700;
    margin: 0;
  }

  .hero-caption {
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .hero-image-wrapper {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-image-placeholder {
    aspect-ratio: 4/5;
  }

  .hero-display {
    position: absolute;
    bottom: -2rem;
    left: 0;
    right: 0;
    margin: 0;
    color: var(--color-brand);
    white-space: nowrap;
    overflow-x: clip;
    z-index: -1;
  }

  /* ---------- Featured Work ---------- */
  .featured-work {
    padding: 4rem 0 6rem;
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .section-head h2 {
    margin: 0;
  }

  .section-more {
    display: flex;
    justify-content: center;
    margin-top: 2.5rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(12px, 2vw, 24px);
  }

  .featured-item {
    min-width: 0;
  }

  .featured-photo {
    display: block;
    text-decoration: none;
  }

  .featured-item--0 .featured-photo {
    aspect-ratio: 16/9;
  }

  .featured-item--1 .featured-photo,
  .featured-item--2 .featured-photo {
    aspect-ratio: 4/5;
  }

  .featured-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.5rem;
    color: #ffffff;
  }

  .featured-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .featured-category {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.9;
  }

  /* ---------- Intro ---------- */
  .intro-section {
    padding: 5rem 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .intro-inner {
    display: grid;
    gap: 2rem;
  }

  .intro-text h2 {
    margin: 0 0 1.5rem;
  }

  .intro-text .text-body {
    margin: 0 0 2rem;
  }

  .intro-cta {
    display: flex;
  }

  /* ---------- CTA ---------- */
  .cta-section {
    padding: 6rem 0;
    text-align: center;
  }

  .cta-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .cta-content h2 {
    margin: 0 0 2rem;
  }

  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  /* ---------- Responsive ---------- */
  @media (min-width: 640px) {
    .featured-grid {
      grid-template-columns: 1fr 1fr;
    }

    .featured-item--0 {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 768px) {
    .hero-stagger {
      padding: 4rem 0 7rem;
    }

    .hero-content-overlap {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: 5fr 7fr;
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    .hero-photo {
      aspect-ratio: 4/5;
    }

    /* Indentasi bertingkat — satu kolom grid per baris (DESIGN §6.1) */
    .hero-title span:nth-child(2) {
      margin-left: 8.333%;
    }

    .hero-title span:nth-child(3) {
      margin-left: 16.667%;
    }
  }

  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(12, 1fr);
      grid-template-rows: repeat(2, 1fr);
    }

    .featured-item--0 {
      grid-column: 1 / 8;
      grid-row: 1 / 3;
    }

    .featured-item--1 {
      grid-column: 8 / 13;
      grid-row: 1;
    }

    .featured-item--2 {
      grid-column: 8 / 13;
      grid-row: 2;
    }

    .featured-item--0 .featured-photo {
      aspect-ratio: auto;
      height: 100%;
    }

    .intro-inner {
      grid-template-columns: 7fr 5fr;
      align-items: center;
    }
  }

  @media (min-width: 1200px) {
    .hero-stagger {
      padding: 5rem 0 8rem;
    }
  }
</style>
