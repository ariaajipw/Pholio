---
/**
 * Shop/Catalog page - product listing
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteConfig } from '../../config/site';
import { formatPrice } from '../../lib/format-price';
import { hasPublicAsset } from '../../lib/has-public-asset';
import productsData from '../../content/products.json';

const config = getSiteConfig();
const { photographer } = config;
---

<BaseLayout title="Katalog" description={`Katalog produk ${photographer} - ${config.tagline}`}>
  <section class="shop-page wa-safe-bottom py-[4rem] pb-[6rem]" aria-labelledby="shop-title">
    <div class="container">
      <header class="page-header text-center mb-[3rem]">
        <h1 id="shop-title" class="text-heading-page mb-[0.75rem] m-0">Katalog Produk</h1>
        <p class="text-caption m-0">Produk digital dan fisik yang tersedia</p>
      </header>

      <div class="shop-grid grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-[clamp(20px,2.5vw,32px)]" role="list">
        {productsData.map((product: any) => (
          <article class="product-card flex flex-col bg-surface border border-border overflow-hidden transition-all duration-120 hover:border-brand hover:shadow-[0_4px_12px_rgba(0,0,0,0.05)]" role="listitem">
            <a
              href={`/products/${product.id}`}
              class="photo-frame product-image-frame block aspect-[4/5] relative no-underline"
              aria-label={`${product.title} — lihat detail`}
            >
              <div class="frame-fallback w-full h-full" aria-hidden="true">
                <svg viewBox="0 0 400 500" fill="none" aria-hidden="true" class="w-full h-full">
                  <rect width="400" height="500" fill="var(--color-border)"/>
                  <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="var(--color-muted)" font-size="14" font-family="system-ui">{product.title}</text>
                </svg>
              </div>
              {hasPublicAsset(product.preview) && (
                <img
                  src={product.preview}
                  alt={product.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
              )}
              {product.featured && (
                <span class="product-badge absolute top-[1rem] right-[1rem] px-[0.75rem] py-[0.25rem] font-bold uppercase tracking-[0.06em] bg-brand text-on-brand" style="font-size: 0.6875rem;">Unggulan</span>
              )}
            </a>

            <div class="product-info flex flex-col p-[1.5rem] gap-[0.5rem] flex-1">
              <span class="font-bold uppercase tracking-[0.08em] text-brand" style="font-size: 0.6875rem;">{product.type === 'digital' ? 'Digital' : 'Fisik'}</span>
              <h2 class="product-title m-0" style="font-size: 1.25rem; font-weight: 800; line-height: 1.25; letter-spacing: -0.01em;">
                <a href={`/products/${product.id}`} class="inline-flex min-h-[44px] items-center text-text no-underline transition-colors duration-120 hover:text-brand hover:underline hover:underline-offset-[0.25em]">{product.title}</a>
              </h2>
              <p class="product-category m-0 uppercase tracking-[0.06em] text-muted" style="font-size: 0.8125rem;">{product.category}</p>
              <p class="product-price m-0 mt-[0.5rem] font-extrabold text-text" style="font-size: 1.5rem; letter-spacing: -0.01em;">{formatPrice(product.price, { currency: product.currency })}</p>
              {product.licenseLabel && (
                <p class="product-license m-0 text-muted" style="font-size: 0.8125rem;">{product.licenseLabel}</p>
              )}
            </div>
          </article>
        ))}
      </div>

      {productsData.length === 0 && (
        <p class="shop-empty text-center text-muted p-[4rem]" style="font-size: 1rem;">Belum ada produk di katalog. Tambahkan data di <code class="bg-border px-[0.375rem] py-[0.125rem] font-mono" style="font-size: 0.875rem;">src/content/products.json</code>.</p>
      )}
    </div>
  </section>
</BaseLayout>
