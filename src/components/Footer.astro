---
/**
 * Footer component
 */
import { getSiteConfig } from '../config/site';

const config = getSiteConfig();
const { photographer, contact, social, navigation, name } = config;
const currentYear = new Date().getFullYear();
---

<footer class="footer bg-surface border-t border-border pt-12 pb-6 md:pt-16 md:pb-24 mt-auto" role="contentinfo">
  <div class="container footer-inner grid gap-8 pb-8 md:gap-12 md:pb-12 md:grid-cols-[repeat(auto-fit,minmax(200px,1fr))] border-b border-border">
    <div class="footer-main">
      <div class="footer-brand">
        <p class="font-bold uppercase tracking-[0.08em] mb-[0.5rem] text-muted m-0" style="font-size: clamp(1.25rem, 2vw, 1.5rem);">{photographer}</p>
        <p class="text-muted m-0" style="font-size: 0.9375rem;">{name} — Portfolio Fotografi & Katalog</p>
      </div>

      <nav class="footer-nav" aria-label="Navigasi footer">
        <ul class="list-none p-0 m-0 flex flex-col gap-[0.75rem]" role="list">
          {navigation.map((item) => (
            <li>
              <a href={item.href} class="inline-flex items-center min-h-[44px] px-[0.5rem] -mx-[0.5rem] text-text no-underline transition-opacity duration-120 hover:opacity-60 hover:text-brand" style="font-size: 0.9375rem;">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-contact">
        <h2 class="font-bold uppercase tracking-[0.08em] text-muted mb-[1rem] m-0" style="font-size: 0.8125rem;">Kontak</h2>
        <address class="text-text leading-[1.8]" style="font-style: normal; font-size: 0.9375rem;">
          {contact.email && (
            <p><a href={`mailto:${contact.email}`} class="inline-flex items-center min-h-[44px] text-inherit no-underline transition-opacity duration-120 hover:opacity-60 hover:text-brand">{contact.email}</a></p>
          )}
          {contact.whatsapp && (
            <p>
              <a href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-[44px] text-inherit no-underline transition-opacity duration-120 hover:opacity-60 hover:text-brand">
                WhatsApp: {contact.whatsapp}
              </a>
            </p>
          )}
          {contact.instagram && (
            <p>
              <a href={`https://instagram.com/${contact.instagram.replace('@', '')}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-[44px] text-inherit no-underline transition-opacity duration-120 hover:opacity-60 hover:text-brand">
                Instagram: {contact.instagram}
              </a>
            </p>
          )}
          {contact.location && (
            <p>{contact.location}</p>
          )}
        </address>
      </div>

      <div class="footer-social">
        <h2 class="font-bold uppercase tracking-[0.08em] text-muted mb-[1rem] m-0" style="font-size: 0.8125rem;">Media Sosial</h2>
        <ul class="list-none p-0 m-0 flex flex-col gap-[0.75rem]" role="list">
          {social.map((item) => (
            <li>
              <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.name} class="flex items-center min-h-[44px] gap-[0.75rem] text-text no-underline transition-opacity duration-120 hover:opacity-60 hover:text-brand" style="font-size: 0.9375rem;">
                {item.icon}
                <span>{item.name}</span>
              </a>
            </li>
          ))}
          {social.length === 0 && contact.instagram && (
            <li>
              <a href={`https://instagram.com/${contact.instagram.replace('@', '')}`} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex items-center min-h-[44px] gap-[0.75rem] text-text no-underline transition-opacity duration-120 hover:opacity-60 hover:text-brand" style="font-size: 0.9375rem;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
                <span>Instagram</span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>


  </div>
  <div class="footer-bottom flex flex-col items-start gap-2 pt-8 mt-4 md:flex-row md:items-center md:justify-between md:gap-4">
    <p class="m-0" style="font-size: 0.8125rem;">
      &copy; {currentYear} {photographer}. Hak cipta dilindungi.
    </p>
  </div>
</footer>